<?xml version="1.0"?>
<ruleset name="gregius-data">
	<description>WordPress Coding Standards for gregius-data.</description>

	<file>.</file>

	<arg name="extensions" value="php"/>

	<config name="testVersion" value="8.2-"/>

	<rule ref="WordPress-Core"/>
	<rule ref="WordPress-Extra"/>
	<rule ref="PHPCompatibility"/>

	<exclude-pattern>vendor/*</exclude-pattern>
	<exclude-pattern>node_modules/*</exclude-pattern>
	<exclude-pattern>build/*</exclude-pattern>
	<exclude-pattern>tests/wp-phpunit/*</exclude-pattern>

	<!-- Test files use the Test_Gregius_Data_* convention (docs/testing/srs.md),
	     not the class-*.php / hyphenated-file-name convention, and legitimately
	     declare helper classes/functions and stub WordPress globals. -->
	<rule ref="WordPress.Files.FileName">
		<exclude-pattern>tests/*</exclude-pattern>
	</rule>
	<rule ref="Generic.Files.OneObjectStructurePerFile">
		<exclude-pattern>tests/*</exclude-pattern>
	</rule>
	<rule ref="Universal.Files.SeparateFunctionsFromOO">
		<exclude-pattern>tests/*</exclude-pattern>
	</rule>
	<rule ref="WordPress.WP.GlobalVariablesOverride">
		<exclude-pattern>tests/*</exclude-pattern>
	</rule>
</ruleset>
