#!/bin/bash
# Gregius Data test runner.
#
# Usage:
#   ./bin/test           Run unit + integration tests (always available, no DB).
#   ./bin/test --wp      Run the WpIntegration suite (needs a reachable MySQL).
#
# The --wp path uses the canonical WordPress install-wp-tests.sh bootstrap:
# it downloads WordPress + the WordPress test suite (wp-phpunit) once, then
# runs PHPUnit against a MySQL test database. Point it at any MySQL via env:
#
#   TEST_DB_NAME          (default: wp_tests)
#   TEST_DB_USER          (required)
#   TEST_DB_PASSWORD      (required)
#   TEST_DB_HOST          (default: 127.0.0.1)
#   WP_VERSION            (default: 7.1.5 — WordPress version under test)
#
# The database must already exist (this runner does not create it; CI uses a
# mysql service container, locally use your docker-compose MySQL).

set -euo pipefail
cd "$(dirname "$(dirname "$0")")"

WP_FLAG="${1:-}"

if [ "$WP_FLAG" = "--wp" ]; then
	DB_NAME="${TEST_DB_NAME:-wp_tests}"
	DB_USER="${TEST_DB_USER:?Set TEST_DB_USER (see header).}"
	DB_PASSWORD="${TEST_DB_PASSWORD:?Set TEST_DB_PASSWORD (see header).}"
	DB_HOST="${TEST_DB_HOST:-127.0.0.1}"
	export WP_TESTS_DIR="${WP_TESTS_DIR:-/tmp/wordpress-tests-lib}"

	echo "=== Installing WordPress test suite (first run only) ==="
	WP_INSTALL_TESTS_SKIP_UPDATE_CHECK=true bash bin/install-wp-tests.sh \
		"$DB_NAME" "$DB_USER" "$DB_PASSWORD" "$DB_HOST" "${WP_VERSION:-7.1.5}" true

	echo ""
	echo "=== Running WpIntegration tests ==="
	WP_TESTS_RUN=1 vendor/bin/phpunit --configuration phpunit-wp.xml.dist
	echo ""
	echo "Done."
else
	echo "=== Running Unit + Integration tests ==="
	php vendor/bin/phpunit
	echo ""
	echo "Run './bin/test --wp' for full WordPress integration tests (MySQL required)."
fi
